# Variables d'environnement de production.
# Copier ce fichier en « .env » à la racine du projet et renseigner les valeurs.
# Chargé par systemd (EnvironmentFile) — voir deploy/etude.service.

# Désactive le mode debug (OBLIGATOIRE en production).
DJANGO_DEBUG=0

# Clé secrète : générer avec
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=remplacer-par-une-cle-longue-et-aleatoire

# Domaines autorisés (séparés par des virgules).
DJANGO_ALLOWED_HOSTS=mon-domaine.fr,www.mon-domaine.fr

# Limitation des tentatives de code d'accès (facultatif ; valeurs par défaut).
# ACCES_MAX_SESSION=8
# ACCES_MAX_IP=100
# ACCES_FENETRE=600
